<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep the TGX proxy secret out of cloud backup. -->
        <exclude
            domain="sharedpref"
            path="tgx_secret.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Do not transfer the TGX proxy secret to another device. -->
        <exclude
            domain="sharedpref"
            path="tgx_secret.xml" />
    </device-transfer>
</data-extraction-rules>
